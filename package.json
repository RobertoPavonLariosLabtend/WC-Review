    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --platform android",
    "check": "npm run lint && npm run typecheck && expo install --check",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
